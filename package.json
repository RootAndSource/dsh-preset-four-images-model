{
  "name": "dsh-preset-four-images-model",
  "version": "1.5.1",
  "description": "四象模型·DSH智能体 — 主体/环境/地位/行为/才能/心态 六维（主体置首）（才能与心态各自独立、不合并）、A诊断+B方案两段式的管理问题分析与方案生成 Preset；零第三方依赖，使用 DSH 官方 subagent 派发",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "agent-preset",
    "management",
    "four-images"
  ],
  "license": "MIT",
  "author": "DaiGuobin-CSU <daiguobin@csu.edu.cn>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RootAndSource/dsh-preset-four-images-model.git"
  },
  "type": "module",
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "cordis.patch.yml",
    "cordis.patch.template.yml",
    "prompts/",
    "scripts/",
    "assets/",
    "index.js",
    "client.js",
    "locale/",
    "icon.png",
    "README.md",
    "INSTALL.md",
    "LICENSE",
    "MANIFEST.md"
  ],
  "scripts": {
    "compose": "node scripts/compose.mjs",
    "compose:check": "node scripts/compose.mjs --check",
    "check": "node scripts/check.mjs",
    "checksums": "node scripts/checksums.mjs",
    "pack": "node scripts/pack.mjs",
    "finalize": "node scripts/finalize.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
