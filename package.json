  },
  "type": "module",
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "files": [
    "cordis.patch.yml",
    "subagents/",
    "scripts/",
    "assets/",
    "README.md",
    "INSTALL.md",
    "LICENSE",
    "MANIFEST.md"
  ],
  "scripts": {
